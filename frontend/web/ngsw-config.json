{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.json",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/assets/**",
          "/**/.*",
          "/**/*",
          "!/**/*.map"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-health",
      "urls": ["/api/v1/health"],
      "cacheConfig": {
        "strategy": "network-only"
      }
    },
    {
      "name": "api-offline-prepare",
      "urls": ["/api/v1/offline/preparar"],
      "cacheConfig": {
        "strategy": "performance",
        "maxAge": "24h",
        "maxSize": 10
      }
    },
    {
      "name": "api-general",
      "urls": ["/api/v1/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxAge": "1d",
        "maxSize": 100
      }
    }
  ]
}
